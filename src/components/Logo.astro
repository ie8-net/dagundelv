---
interface Props {
  large?: boolean;
}

const { large = false } = Astro.props;
const size = large ? 40 : 30;
---

<div class={`logo ${large ? 'logo-lg' : ''}`}>
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 30 30" aria-hidden="true">
    <rect width="30" height="30" rx="7" class="logo-mark-bg" />
    <text x="15" y="21" text-anchor="middle" class="logo-mark-text">8</text>
  </svg>
  <span class="logo-word">ie8<span class="logo-word-muted">.net</span></span>
</div>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .logo-mark-bg {
    fill: var(--accent);
  }

  .logo-mark-text {
    font-size: 16px;
    font-weight: 800;
    fill: var(--accent-contrast);
    font-family: inherit;
  }

  .logo-word {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .logo-word-muted {
    color: var(--text-muted);
    font-weight: 600;
  }

  .logo-lg .logo-word {
    font-size: 28px;
  }

  .logo-lg .logo-mark-text {
    font-size: 21px;
  }
</style>
