<div class="tool-card">
  <div class="tool-header">
    <span class="card-icon">🔑</span>
    <span class="card-name">密码生成器</span>
  </div>
  <div class="tool-body">
    <input id="pwd-output" type="text" readonly />
    <div class="tool-row">
      <label class="tool-len">
        长度
        <input id="pwd-length" type="number" min="4" max="64" value="16" />
      </label>
      <label><input id="pwd-upper" type="checkbox" checked /> 大写</label>
      <label><input id="pwd-lower" type="checkbox" checked /> 小写</label>
      <label><input id="pwd-digit" type="checkbox" checked /> 数字</label>
      <label><input id="pwd-symbol" type="checkbox" /> 符号</label>
    </div>
    <div class="tool-actions">
      <button id="pwd-generate" type="button">生成</button>
      <button id="pwd-copy" type="button">复制</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const output = document.getElementById('pwd-output');
    const lengthInput = document.getElementById('pwd-length');
    const upper = document.getElementById('pwd-upper');
    const lower = document.getElementById('pwd-lower');
    const digit = document.getElementById('pwd-digit');
    const symbol = document.getElementById('pwd-symbol');
    const generateBtn = document.getElementById('pwd-generate');
    const copyBtn = document.getElementById('pwd-copy');

    const SETS = {
      upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
      lower: 'abcdefghijklmnopqrstuvwxyz',
      digit: '0123456789',
      symbol: '!@#$%^&*()-_=+[]{}?',
    };

    function generate() {
      let pool = '';
      if (upper.checked) pool += SETS.upper;
      if (lower.checked) pool += SETS.lower;
      if (digit.checked) pool += SETS.digit;
      if (symbol.checked) pool += SETS.symbol;
      if (!pool) pool = SETS.lower;

      const len = Math.min(64, Math.max(4, parseInt(lengthInput.value, 10) || 16));
      const bytes = new Uint32Array(len);
      crypto.getRandomValues(bytes);
      let result = '';
      for (let i = 0; i < len; i++) {
        result += pool[bytes[i] % pool.length];
      }
      output.value = result;
    }

    generateBtn.addEventListener('click', generate);
    copyBtn.addEventListener('click', () => {
      if (!output.value) return;
      navigator.clipboard.writeText(output.value);
      copyBtn.textContent = '已复制';
      setTimeout(() => (copyBtn.textContent = '复制'), 1200);
    });

    generate();
  })();
</script>
