---
import Icon from './Icon.astro';

interface Props {
  name: string;
  desc?: string;
  iconKey: string;
  modalId: string;
  featured?: boolean;
}

const { name, desc, iconKey, modalId, featured = false } = Astro.props;
---

<button
  type="button"
  class={`card card-button ${featured ? 'card-featured' : ''}`}
  data-open-modal={modalId}
>
  <span class="card-icon">
    <Icon name={iconKey} />
  </span>
  <span class="card-body">
    <span class="card-name">{name}</span>
    {desc && <span class="card-desc">{desc}</span>}
  </span>
</button>
