---
import type { LinkItem } from '../data/links';
import { monogram } from '../data/links';
import Icon from './Icon.astro';

interface Props {
  title: string;
  items: LinkItem[];
  featured?: boolean;
}

const { title, items, featured = false } = Astro.props;
---

<section class="section">
  <h2 class="section-title">{title}</h2>
  <div class="card-grid">
    {
      items.map((item) => {
        const mono = monogram(item.name);
        return (
          <a class={`card ${featured ? 'card-featured' : ''}`} href={item.url} target="_blank" rel="noopener noreferrer">
            <span class="card-icon">
              {item.iconKey ? (
                <Icon name={item.iconKey} />
              ) : (
                <span class="card-icon-mono" style={`background:${mono.color}`}>{mono.letter}</span>
              )}
            </span>
            <span class="card-body">
              <span class="card-name">{item.name}</span>
              {item.desc && <span class="card-desc">{item.desc}</span>}
            </span>
          </a>
        );
      })
    }
  </div>
</section>
