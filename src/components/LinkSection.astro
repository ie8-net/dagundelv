---
import type { LinkItem } from '../data/links';
import BrandTile from './BrandTile.astro';

interface Props {
  title: string;
  items: LinkItem[];
  featured?: boolean;
}

const { title, items, featured = false } = Astro.props;
---

<section class="section">
  <h2 class="section-title">{title}</h2>
  <div class="card-grid">
    {
      items.map((item) => (
        <a class={`card ${featured ? 'card-featured' : ''}`} href={item.url} target="_blank" rel="noopener noreferrer">
          <span class="card-icon">
            <BrandTile name={item.name} iconKey={item.iconKey} brandIcon={item.brandIcon} color={item.color} />
          </span>
          <span class="card-body">
            <span class="card-name">{item.name}</span>
            {item.desc && <span class="card-desc">{item.desc}</span>}
          </span>
        </a>
      ))
    }
  </div>
</section>
