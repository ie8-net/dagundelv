---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="modal-overlay" data-modal-id={id} hidden>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-label={title}>
    <div class="modal-panel-header">
      <span class="modal-panel-title">{title}</span>
      <button type="button" class="modal-close" data-close-modal aria-label="关闭">
        <Icon name="close" />
      </button>
    </div>
    <div class="modal-panel-body">
      <slot />
    </div>
  </div>
</div>
